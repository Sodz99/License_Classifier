# Code-only whitelist: ignore everything, then allow source files back in
*
!*/
!.gitignore
!.gitattributes
!*.py
!*.ipynb
!*.sql
!*.r
!*.R
!*.sh
!*.ps1
!*.bat
!*.js
!*.ts
!*.html
!*.css
!*.java
!*.scala
!*.yml
!*.yaml
!*.toml
!*.cfg
!*.ini
!*.conf
!*.md
!requirements*.txt
!Dockerfile
!Makefile
!Procfile
!.env.example

# Never commit, even inside allowed folders
**/__pycache__/
**/.ipynb_checkpoints/
**/__MACOSX/
**/venv/
**/.venv/
**/env/
**/site-packages/
**/node_modules/
**/.env
**/.env.*
!**/.env.example
**/data/
**/input/
**/Database_backup/
**/.conda/
**/cdk.out/
**/TOS_DI-*/
**/darknet/
**/labelImg-master/
**/jTessBoxEditor*/
**/Tesseract-OCR/

# Too large or duplicate
/modular_code/Deep-Neural-Network.ipynb
/modular_code/Model_Api.ipynb
/modular_code/requirements.txt
/modular_code/src/Engine.py
/modular_code/src/ML_Pipeline/Predict.py
/modular_code/src/ML_Pipeline/Preprocess.py
/modular_code/src/ML_Pipeline/Train_Model.py
/modular_code/src/ML_Pipeline/Utils.py
/modular_code/src/ML_Pipeline/deploy.py
/modular_code/src/ML_Pipeline/wsgi.py
/modular_code/src/ML_Pipeline/wsgi.sh
